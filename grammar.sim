! fun grammer for me and you ;

begin
	external class ArrayList; ! declare array list;
	external class GrammarGenerator;
	
	! replace a char with a char like .replace("a", "") in js; 
	text procedure replace(inputText, ch_from, ch_to); 
	Text inputText;
	Character ch_from, ch_to;
	begin
		text result;
		
		result :- Blanks(100);
		
		! set positions ;
		inputText.setpos(1);
		result.setpos(1);
		
		while inputText.more do begin
			Character currentChar;
			
			currentChar := inputText.getchar
			! if we have our swapped char;
			if (currentChar = ch_from) then begin
				if not (ch_to = ' ') then begin
					currentChar := ch_to;
					result.putchar(currentChar);
					outchar(currentChar);
				end;
			end 
			else begin
				result.putchar(currentChar);
			end;
		end;
		
		replace :- result.strip;
	end;

	
	
	! procedure to parseGrammer ;
	text procedure parseGrammer(production, element_keys, content);
	text production;
	ref (ArrayList) element_keys;
	ref (ArrayList) array content;
	begin 
		text result;
		integer key_index, seed, rInt;
		ref (ArrayList) prod_content;
		! get the key for production content;
		key_index := element_keys.indexOf(production);
		OutText("The index of prod: "  & production & " is: "); 
		OutInt(key_index, 2);
		outImage;
		
		!get content ;
		prod_content :- content(key_index);
		!prod_content.print;
		seed := 12543428;
		rInt := randint(1,prod_content.length,seed);
		outInt(rInt, 6); outImage;
		OutText(prod_content.get(rInt));
		
		! put stuff in array. Each index has either
		  a string or production
		;
		
		
		! look though array to find produxtion and recurse replace the <production> for new string;
		
		! iterate array and add to result ;

		! clean the result ;
		result :- result.strip;
		outimage;
		parseGrammer :- "wip"
	end;
	
	

	text file_name, read_image, start_production;
	ref (infile) file;
	ref (ArrayList) element_keys; ! create the array of <a>;
	ref (ArrayList) array content(1:100); ! create array of content for the element;
	boolean inProduction, firstLine;  ! track if we are in {} ;
	integer content_pointer;
	ref (GrammarGenerator) gg;
	
	! initialize values ;
	inProduction := false;
	firstLine := false;
	element_keys :- new ArrayList(100);
	content_pointer := 1; ! to keep track of where we are adding;
	start_production :- ""; ! what is the start of out stuff ;
	gg :- new GrammarGenerator( 83948 );

	
	file_name :- "edd.g";
	read_image :- Blanks(100);
	
	file :- new infile(file_name);
	
	file.open(read_image);
	
	! parse the read image ;
	while not file.endfile do begin
		text line;
		! read line on to image ;
		file.inimage;
		
		! clean image and on to line we are reading;
		line :- Copy(read_image).strip;
		
		
		if not (line = "") then begin
			outInt(line.Length, 6);
			outText(" ");
			outText(read_image);
			
			! if in brakets set production;
			if (line = "{") then begin 
				inproduction := true;
				firstLine := true;
				outText("enter productions");
			end
			else if (line = "}") then begin
				inproduction := false;
				outText("produtcion exit");
			end
			else if (inproduction) then begin 
				if(firstLine) then begin
					outText("fisrt Line")
					gg.add_key(line);
					firstLine := false;
					if (start_production = "") then start_production :- line;
				end
				else begin 
					line :- replace(line, ';', ' ').strip;
					gg.add_content(line)
					OutText("added to "); 
					OutText(gg.current_add);
				end;
			end;
			
			
			outImage;
		end;
			
		
	end;
	outImage;
	!element_keys.print;
	!gg.get_content_int(1).print;
	!content(2).print;
	!outImage;
	outText(gg.generateRec("<defect_type>"));
	!outImage;
	!outText(start_production);
	file.close;
end;
