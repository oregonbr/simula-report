external class ArrayList;

class GrammarGenerator (seed);
	integer seed;
begin 
	ref (ArrayList) element_keys;
	ref (ArrayList) array content(1:100);
	integer content_pointer;
	
	! --------------------------------------------- ;
	!                key content stuff              ;                  
	! --------------------------------------------- ;
		
	procedure add_key(key); text key;
	begin
		element_keys.add(key);
		content(content_pointer) :- new ArrayList(50);
		content_pointer := content_pointer + 1;
	end;
	
	! add content based on current pointer minus one ;
	procedure add_content(input); text input; content(content_pointer - 1).add(input);
	
	! where is the pointer minus 1 at? ;
	text procedure current_add; current_add :- element_keys.get(content_pointer - 1);
	
	procedure set_pointer(number); integer number; content_pointer := number;

	! get the list of keys ;
	ref (ArrayList) procedure get_keys; get_keys :- element_keys;
	
	! get the content of a key ;
	ref (ArrayList) procedure get_content(key); text key; get_content :- content(element_keys.indexOf(key));
	
	! get the content from a index ;
	ref (ArrayList) procedure get_content_int(index); integer index; get_content_int :- content(index);
	
	! --------------------------------------------- ;
	!                text line parsing              ;                  
	! --------------------------------------------- ;
	
	! split by isolating production in an array ;
	ref (ArrayList) procedure split_productions(input_line); text input_line; begin
		text segment;
		integer i, p; ! for loop i, pointer p;
		ref (ArrayList) elements;
		outimage;
		segment :- Blanks(1000); ! idk if copy is nessesary;
		p := 1;
		input_line.setpos(1);
		segment.setpos(1);
		elements :- new ArrayList(100)
		
		! iterate line chars ;
		while input_line.more do begin
			character cur_char;
			
			cur_char := input_line.getChar;
			! when < shows up, then we have a production or close on > ;
			if (cur_char = '<' or cur_char = '>') then begin
			
				! we send out to array what we have ;
				if not(segment = "") then begin 
					text outText;
					elements.add(segment.strip) ;
					
					! clear segment to begin adding this;
					segment :- Blanks(1000);
					segment.setpos(1);
				end;
					
			end
			else begin
				! else add the character;
				segment.putChar(cur_char);
			end;
			
		end;
		elements.print;
		split_productions :- elements;
	end;
	
	
	! --------------------------------------------- ;
	!                generator content              ;                  
	! --------------------------------------------- ;
	
	text procedure generate; begin
		
	
		generate :- "wip";
	end;
	
	! main stuff ;
	text procedure generateRec(production); text production; begin
		text result, rand_line;
		integer rInt;
		ref (ArrayList)	prod_cont, split_cont;
		
		prod_cont :- get_content(production);
		prod_cont.print;	
		
		rInt := randint(1,prod_cont.length,seed);
		outInt(rInt, 6);outImage;
		rand_line :- prod_cont.get(rInt)
		OutText(rand_line);
		
		! put stuff in array. Each index has either
		  a string or production
		;
		split_cont :- split_productions(rand_line);
		
		! look though array to find produxtion and recurse replace the <production> for new string;
		
		! iterate array and add to result ;

		! clean the result ;
		!result :- result.strip;
		generateRec :- Copy("wip");
	end;

	content_pointer	:= 1;
	element_keys :- new ArrayList(100);
end;